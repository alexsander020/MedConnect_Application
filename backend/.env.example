# Ambiente de execução (development, production, test)
NODE_ENV=development

# Porta do servidor HTTP
PORT=3000

# URL de conexão com o banco de dados (Prisma PostgreSQL)
DATABASE_URL="postgresql://medconnect_user:medconnect_dev_password_only_for_local@localhost:5432/medconnect?schema=public"

# Segredo para assinatura de tokens JWT (OBRIGATÓRIO: mínimo de 32 caracteres)
JWT_SECRET=substitua_por_um_segredo_jwt_com_pelo_menos_32_caracteres_gerado_com_seguranca

# Chave para criptografia de CPF (AES-256-GCM: exatamente 32 bytes em hex / 64 caracteres)
CPF_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Armazenamento em nuvem - Cloudinary (opcional em desenvolvimento/teste, OBRIGATÓRIO em produção)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Provedor de E-mail (SMTP) - Opcional em desenvolvimento (usa console), configurável para SendGrid, Resend, Mailgun ou SES
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MedConnect <nao-responda@medconnect.com.br>
