generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  PHARMACY
  ADMIN
}

enum PrescriptionStatus {
  PENDING
  QUOTED
  ACCEPTED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  PRODUCTION
  DELIVERY
  DELIVERED
  CANCELLED
}

enum PharmacyVerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(PATIENT)
  phone         String?
  address       String?
  cpfEncrypted  String?
  cpfHash       String?        @unique
  cpfLastDigits String?
  emailVerified Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  prescriptions Prescription[]
  reviews       Review[]
}

model Pharmacy {
  id                       String                     @id @default(uuid())
  name                     String
  email                    String                     @unique
  password                 String
  cnpj                     String                     @unique
  phone                    String?
  address                  String?
  deliveryArea             String?
  verified                 Boolean                    @default(false)
  verificationStatus       PharmacyVerificationStatus @default(PENDING_VERIFICATION)
  sanitaryLicense          String?
  operatingAuth            String?
  technicalResponsibleName String?
  technicalResponsibleCrf  String?
  technicalResponsibleUf   String?
  documentUrl              String?
  verifiedById             String?
  verifiedAt               DateTime?
  rejectionReason          String?
  cnpjData                 String?
  emailVerified            Boolean                    @default(false)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  quotes                   Quote[]
  reviews                  Review[]
}

model Prescription {
  id         String                  @id @default(uuid())
  patientId  String
  fileUrl    String
  status     PrescriptionStatus      @default(PENDING)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  patient    User                    @relation(fields: [patientId], references: [id])
  quotes     Quote[]
  accessLogs PrescriptionAccessLog[]

  @@index([patientId, status])
}

model Quote {
  id             String       @id @default(uuid())
  prescriptionId String
  pharmacyId     String
  priceCents     Int
  deliveryDays   Int?
  notes          String?
  status         QuoteStatus  @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  pharmacy       Pharmacy     @relation(fields: [pharmacyId], references: [id])
  order          Order?

  @@unique([prescriptionId, pharmacyId])
  @@index([prescriptionId])
  @@index([pharmacyId])
}

model Order {
  id        String               @id @default(uuid())
  quoteId   String               @unique
  status    OrderStatus          @default(PRODUCTION)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  quote     Quote                @relation(fields: [quoteId], references: [id])
  history   OrderStatusHistory[]
  review    Review?
}

model OrderStatusHistory {
  id            String      @id @default(uuid())
  orderId       String
  fromStatus    OrderStatus
  toStatus      OrderStatus
  changedByType Role
  changedById   String
  createdAt     DateTime    @default(now())
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Review {
  id         String   @id @default(uuid())
  orderId    String   @unique
  patientId  String
  pharmacyId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patient    User     @relation(fields: [patientId], references: [id])
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([pharmacyId])
  @@index([patientId])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String?
  pharmacyId String?
  type       String
  title      String
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([pharmacyId])
}

model PrescriptionAccessLog {
  id             String       @id @default(uuid())
  prescriptionId String
  accessedById   String
  accessedByType Role
  ipAddress      String?
  createdAt      DateTime     @default(now())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String?
  pharmacyId String?
  tokenHash  String   @unique
  familyId   String
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([familyId])
  @@index([userId])
  @@index([pharmacyId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

