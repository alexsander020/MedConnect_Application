generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  PHARMACY
  ADMIN
}

enum PrescriptionStatus {
  PENDING
  QUOTED
  ACCEPTED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  PRODUCTION
  DELIVERY
  DELIVERED
  CANCELLED
}

enum PharmacyVerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum PrescriptionKind {
  HUMAN
  VETERINARY
}

enum VetDocumentType {
  MAGISTRAL
  CONTROLLED_NOTIFICATION
}

enum CapabilityType {
  HUMAN_COMPOUNDING
  VETERINARY_COMPOUNDING
}

enum CapabilityStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum AnimalSpecies {
  DOG
  CAT
  BIRD
  REPTILE
  SMALL_MAMMAL
  EQUINE
  OTHER
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(PATIENT)
  phone         String?
  address       String?
  cpfEncrypted  String?
  cpfHash       String?        @unique
  cpfLastDigits String?
  isAnonymized  Boolean        @default(false)
  anonymizedAt  DateTime?
  keyId         String?        @default("v1")
  emailVerified Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  prescriptions Prescription[]
  animals       Animal[]
  reviews       Review[]
  consents      Consent[]
}

model Pharmacy {
  id                       String                     @id @default(uuid())
  name                     String
  email                    String                     @unique
  password                 String
  cnpj                     String                     @unique
  phone                    String?
  address                  String?
  deliveryArea             String?
  verified                 Boolean                    @default(false)
  verificationStatus       PharmacyVerificationStatus @default(PENDING_VERIFICATION)
  sanitaryLicense          String?
  operatingAuth            String?
  technicalResponsibleName String?
  technicalResponsibleCrf  String?
  technicalResponsibleUf   String?
  documentUrl              String?
  verifiedById             String?
  verifiedAt               DateTime?
  rejectionReason          String?
  cnpjData                 String?
  emailVerified            Boolean                    @default(false)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  quotes                   Quote[]
  reviews                  Review[]
  capabilities             PharmacyCapability[]
}

model Animal {
  id              String         @id @default(uuid())
  tutorId         String
  name            String
  species         AnimalSpecies
  breed           String?
  weightGrams     Int
  birthDate       DateTime?
  isFoodProducing Boolean        @default(false)
  notes           String?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tutor           User           @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  prescriptions   Prescription[]

  @@index([tutorId, deletedAt])
}

model PharmacyCapability {
  id                        String           @id @default(uuid())
  pharmacyId                String
  type                      CapabilityType
  status                    CapabilityStatus @default(PENDING_VERIFICATION)
  mapaRegistrationNumber    String?
  crmvCompanyRegistration   String?
  crmvCompanyUf             String?
  technicalResponsibleName  String?
  technicalResponsibleCrf   String?
  technicalResponsibleCrfUf String?
  evidenceFileKeys          String[]         @default([])
  verifiedByAdminId         String?
  verifiedAt                DateTime?
  rejectionReason           String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  pharmacy                  Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, type])
  @@index([pharmacyId])
  @@index([type, status])
}

model Prescription {
  id                           String                  @id @default(uuid())
  patientId                    String
  fileUrl                      String
  status                       PrescriptionStatus      @default(PENDING)
  kind                         PrescriptionKind        @default(HUMAN)
  petId                        String?
  prescriberName               String?
  prescriberCrmv               String?
  prescriberUf                 String?
  vetDocumentType              VetDocumentType?
  controlledNotificationNumber String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  patient                      User                    @relation(fields: [patientId], references: [id])
  pet                          Animal?                 @relation(fields: [petId], references: [id])
  quotes                       Quote[]
  accessLogs                   PrescriptionAccessLog[]

  @@index([patientId, status])
  @@index([kind, status])
}

model Quote {
  id                       String       @id @default(uuid())
  prescriptionId           String
  pharmacyId               String
  priceCents               Int
  deliveryDays             Int?
  notes                    String?
  pharmaceuticalForm       String?
  flavoring                String?
  estimatedPreparationDays Int?
  status                   QuoteStatus  @default(PENDING)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  prescription             Prescription @relation(fields: [prescriptionId], references: [id])
  pharmacy                 Pharmacy     @relation(fields: [pharmacyId], references: [id])
  order                    Order?

  @@unique([prescriptionId, pharmacyId])
  @@index([prescriptionId])
  @@index([pharmacyId])
}

model Order {
  id        String               @id @default(uuid())
  quoteId   String               @unique
  status    OrderStatus          @default(PRODUCTION)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  quote     Quote                @relation(fields: [quoteId], references: [id])
  history   OrderStatusHistory[]
  review    Review?
}

model OrderStatusHistory {
  id            String      @id @default(uuid())
  orderId       String
  fromStatus    OrderStatus
  toStatus      OrderStatus
  changedByType Role
  changedById   String
  createdAt     DateTime    @default(now())
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Review {
  id         String   @id @default(uuid())
  orderId    String   @unique
  patientId  String
  pharmacyId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patient    User     @relation(fields: [patientId], references: [id])
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([pharmacyId])
  @@index([patientId])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String?
  pharmacyId String?
  type       String
  title      String
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([pharmacyId])
}

model PrescriptionAccessLog {
  id             String       @id @default(uuid())
  prescriptionId String
  accessedById   String
  accessedByType Role
  ipAddress      String?
  createdAt      DateTime     @default(now())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String?
  pharmacyId String?
  tokenHash  String   @unique
  familyId   String
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([familyId])
  @@index([userId])
  @@index([pharmacyId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model Consent {
  id               String    @id @default(uuid())
  userId           String
  userType         Role      @default(PATIENT)
  consentType      String
  textVersion      String
  textHash         String?
  ipAddress        String?
  userAgent        String?
  consentedAt      DateTime  @default(now())
  revokedAt        DateTime?
  revokedIp        String?
  revocationReason String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
  @@index([revokedAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorType  Role
  actorEmail String?
  action     String
  resource   String
  resourceId String?
  reason     String
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
}

