{
  "name": "medconnect-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for MedConnect Application (Frontend + Backend)",
  "workspaces": [
    "MedConnect",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev -w backend\" \"npm run dev -w MedConnect\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w MedConnect",
    "test": "concurrently -n \"FRONTEND,BACKEND\" -c \"magenta,cyan\" \"npm run test -w MedConnect\" \"npm run test -w backend\"",
    "test:frontend": "npm run test -w MedConnect",
    "test:backend": "npm run test -w backend",
    "test:e2e": "playwright test",
    "build": "npm run build -w MedConnect && npm run build -w backend",
    "build:frontend": "npm run build -w MedConnect",
    "build:backend": "npm run build -w backend",
    "lint": "npm run lint -w MedConnect",
    "db:up": "npm run db:up -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:studio": "npm run db:studio -w backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.4",
    "deepmerge-ts": "^8.0.2"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "follow-redirects": "^1.16.2"
  }
}
